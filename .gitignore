__pycache__/
*.py[cod]
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.env
*.env.local
data/*
# Published baseline (referenced from docs-site/evaluation). Re-include needs
# the parent data/* form above, NOT data/, so the child paths can match.
!data/evaluation/
data/evaluation/*
!data/evaluation/benchmark_results.json
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*.db
.claude/
review_batch_*.jsonl
.review_local/

# Pytest project-local basetemp (was breaking ruff/bandit scans)
.tmp/
.pytest-tmp*/
tests/pytest-cache-files-*

# Regression eval artefacts (runtime output, не должны попадать в repo)
reports/regression/*.log
reports/regression/*.err
reports/regression/*.json
reports/regression/*.md
reports/ragas/*.json
reports/ragas/*.md

# Judge plan of a baseline run: the repository keeps the packed plan.json.gz
reports/baseline/*/judge/plan.json

# Autopilot runtime state
.autopilot/
.myflow/

# Playwright MCP captures (per-session diagnostic, not site assets)
.playwright-mcp/

# Ad-hoc QA screenshots at repo root (per-session captures, not committed assets)
/*.png

# pytest basetemp trees (local test-run artifacts, never evidence)
.pytest_tmp*/

# Machine-local leftovers cleared out of the root (per-session captures, test
# temp trees, the phase C.1b run bundle): kept on disk, never committed
archive/local/
