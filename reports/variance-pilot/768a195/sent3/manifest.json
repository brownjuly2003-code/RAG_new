  "cases": [
    {
      "case_id": "T64-01",
      "query": "Кто согласовывает бюджет релокации и какое предложение получает сотрудник после положительного решения? Ответьте по политике релокации.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-02",
      "query": "Нужен юрист для международных контрактов. Что шаблон его должностной инструкции требует по образованию и языку? Уровень английского не придумывай.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-03",
      "query": "Для какой цели формируется кадровый резерв в ООО «Северный Контур» и на какие позиции он ориентирован?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-04",
      "query": "Коллега говорит, что соглашение о неразглашении для сотрудников касается только тарифов, а авианакладные и журналы доступа туда не входят. Исправь это по разделу «Назначение» соглашения.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-05",
      "query": "Какие события в терминах договора страхования гражданской ответственности перевозчика возвращают проект к юристам, операционной команде и финансовому отделу или специалистам по страхованию?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-06",
      "query": "В старой памятке мне написали 60% больничного после несчастного случая. Что именно обещает раздел «Выплаты и льготы» этой внутренней политики и зависит ли процент от стажа? Не выдавай это за проверку действующего закона.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-07",
      "query": "Какие требования к стажу старшего логиста и к владению системами перечисляет его должностная инструкция?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-08",
      "query": "Когда шаблон допсоглашения к трудовому договору применяется, а когда сам раздел «Область применения» направляет к ст. 74? Перескажи ограничение шаблона, без юридического решения за нас.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-09",
      "query": "Назовите поля политики сроков хранения данных, которые описывают категорию рейсового документа, приостановку удаления и систему хранения. Укажите точные ключи полей.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-10",
      "query": "Принимаем человека на замещение, а потом оформляем внутренний перевод по новому месту. Какие ситуации охватывает шаблон приказа о приеме и одинаковые ли формулировки использовать?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-11",
      "query": "Сопоставьте ограничения доказательств в контрольном списке претензии об утрате и критериях претензии о повреждении авиагруза: без чего нельзя считать утрату доказанной и без чего нельзя утверждать причину повреждения?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-12",
      "query": "Готовим постановку целей и отбор в кадровый резерв. Какие показатели задаются при оценке результативности и какой минимальный результат последней оценки нужен резервисту?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-13",
      "query": "Как запрет скрытого профилирования в политике использования файлов веб-аналитики сочетается с результатом подключения агента к порталу бронирования в политике обработки персональных данных? Укажите ограничение аналитики и объём и контроль данных агента.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-14",
      "query": "На складе спорят об открытой обуви и аптечке. Что запрещает дресс-код и чем рабочее место должно быть обеспечено по общей инструкции ОТ?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-15",
      "query": "По правилам FAQ о претензиях куда направляется конкретный спор, и какое ограничение контрольного списка претензии об утрате нужно сохранить в ответе? Дайте общий ответ, не решая конкретный спор.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-16",
      "query": "В назначении шаблона отчета вижу «продление испытательного срока». Значит, слабый review позволяет добавить месяц? Сверь это с этапом 5 регламента испытания и исправь посылку.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-17",
      "query": "Когда и кем заполняется отчёт об испытательном сроке по шаблону, и кто проверяет процедуры и документы на этапе итоговой оценки регламента?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-18",
      "query": "Удалёнщик говорит, что правила внутреннего общения его не касаются, а начальник требует связь круглосуточно. Что говорят область применения правил коммуникации и раздел контроля удалённой работы?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-19",
      "query": "Как определены основной оплачиваемый отпуск и рабочий год, и кто и на каких основаниях открывает карточку «Заявление на отпуск»? Используйте положение и шаблон заявления.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-20",
      "query": "Сравни роли по претензиям о таможенной задержке и повреждении: кто ведёт хронологию и какие события у каждой роли?",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-21",
      "query": "В перечнях доказательств критериев уведомления об арбитраже и контрольного списка претензии об утрате сколько дословно одинаково названных видов доказательств? Перечислите пересечение; основную и домовую авианакладные считайте одним видом.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-22",
      "query": "Собираю HR-календарь: сколько отдельных обязанностей со сроком записано только в разделе согласования отпуска и области применения шаблона отчёта об испытании? Назови ответственных и каждый срок; одинаковые числа не объединяй.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-23",
      "query": "В таблицах взаимодействия HR-менеджера и логиста сколько подразделений названы одинаково у обоих? Перечислите только пересечение таблиц.",
      "subset": "pilot-gold"
    },
    {
      "case_id": "T64-24",
      "query": "Для чек-листа смены должности и перевода посчитай уникальные документы: только строка «Документ» таблицы отличий и первые два пункта «Действия после подписания» приказа о переводе. Перечисли их; трудовую книжку считай одной, акт передачи — отдельным документом.",
      "subset": "pilot-gold"
    }
  ],
