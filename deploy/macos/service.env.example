# The chat service's deployment keys; deploy/macos/start.py reads them.
# Copy this file to ~/.config/rag-new/chat-service.env on the Mac, chmod 600, and fill in the
# values there with an editor, never on a command line. One KEY=VALUE a line: no quotes, no
# spaces around "=", no "export", LF line ends. No value is ever printed. A key not listed
# here is refused: the model, the limits and every quality setting keep the code defaults
# (PLAN.md stage 6, item 2). A value left with a placeholder (<...>) is refused too.

# --- start.py's own keys; they do not reach the API ---
# The memory policy stage 4 names (PLAN.md stage 4, item 5); while it is undecided the
# service does not start. One of: undecided | none | cache-ram:<MiB> | unload-every:<N> |
# unload-at-swap:<MB>. The two unloads are not built yet and refuse.
RAG_SERVICE_MEMORY_POLICY=undecided
# Ollama's server log, where healthcheck.py reads llama-server's cache limit (cache-ram only).
RAG_SERVICE_OLLAMA_LOG=/Users/julia/gr2_bench/ollama_serve.log

# --- the deployment ---
# The session store: a PostgreSQL database of the service's own (macos-service.md, "Before
# install"). A password with URL-special characters is percent-encoded.
DATABASE_URL=postgresql+asyncpg://<role>:<password>@127.0.0.1:55432/<database>
# The service's own byte-identical copy of the aircargo index.
VECTORDB_CHROMA_DIR=/Users/julia/.local/share/rag-new/chat-service/index/chroma
# Measured INT8 export; start.py checks its SHA-256 before starting the API.
RAG_RERANKER_ONNX=/Users/julia/RAG_new_ort/bge-reranker-v2-m3/int8/model.onnx
# Secrets, each from: $PY -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<at least 32 random characters>
SESSION_SECRET_KEY=<at least 32 random characters>
DB_ENCRYPTION_KEY=<at least 16 random characters>
# The chat's login: a bcrypt hash of the password, and the tenant its token names. With the
# hash set, admin/admin no longer logs in (api/routers/session_auth.py).
ADMIN_USERNAME=<login name>
ADMIN_PASSWORD_HASH=<bcrypt hash>
ADMIN_DEFAULT_TENANT=aircargo
CORS_ORIGINS=http://127.0.0.1:8002
# Only when a separate migrator role applies the migrations; the code default is true.
# AUTO_MIGRATE=false
