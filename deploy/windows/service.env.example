# Copy outside the checkout: default %LOCALAPPDATA%/rag-new/chat-service.env,
# or D:/RAG_new_prod/chat-service.env passed as the launcher's only argument.
# UTF-8 without BOM, LF, one KEY=VALUE per line. No quotes, export or padding.
# Values may contain spaces internally. Unknown keys and <placeholders> refuse startup.
# Restrict the file's Windows ACL to the owner and necessary system administrators.
# No values are logged. Set secrets in an editor, never in command-line arguments.

# Laptop profile: every model call uses Codex. Ollama is not needed and must not run.
# Embedding and reranking remain local. Omission still defaults to local-first.
LLM_PROVIDER_PROFILE=codex-only
# Native executable, never the npm .cmd shim. Update this if npm moves the binary.
CODEX_BINARY=C:/Users/uedom/AppData/Roaming/npm/node_modules/@openai/codex/node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe
# The owner's existing signed-in profile; do not copy or print its credentials.
CODEX_HOME=C:/Users/uedom/.codex-work
# Prepared embedding and reranker tokenizer snapshots; startup forces offline mode.
HF_HOME=D:/RAG_new_prod/hf-cache
DATABASE_URL=postgresql+asyncpg://<role>:<password>@127.0.0.1:55432/<database>
VECTORDB_CHROMA_DIR=D:/RAG_new_prod/index/chroma
RAG_RERANKER_ONNX=D:/RAG_new_prod/models/bge-reranker-v2-m3/int8/model.onnx
JWT_SECRET=<at least 32 random characters>
# Optional: if omitted or empty, the same shared rule falls back to JWT_SECRET.
SESSION_SECRET_KEY=<at least 32 random characters>
DB_ENCRYPTION_KEY=<at least 16 random characters>
ADMIN_USERNAME=<login name>
ADMIN_PASSWORD_HASH=<bcrypt hash>
ADMIN_DEFAULT_TENANT=aircargo
CORS_ORIGINS=http://127.0.0.1:8002
# Only if a separate migrator already applied the schema; the code default is true.
# AUTO_MIGRATE=false

# No model/quality/timeout tuning, memory-policy or Ollama-log keys are accepted.
# HF_HUB_OFFLINE=1 and TRANSFORMERS_OFFLINE=1 are set by the launcher, not this file.
